---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
// A protected post's body is a ciphertext blob (see src/lib/postCrypto.ts), not markdown —
// rendering it through remark would just spit out the encrypted gibberish. BlogPost shows a
// password prompt instead and decrypts it client-side.
const isProtected = post.data.protected === true;
const { Content } = isProtected ? { Content: null } : await render(post);
---

<BlogPost slug={post.id} body={post.body} {...post.data}>
  {Content && <Content />}
</BlogPost>
