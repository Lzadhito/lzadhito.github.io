---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';
import { year } from '../../lib/format';

const posts = await getPosts();
const groups = new Map<string, typeof posts>();
for (const post of posts) {
  const y = year(post.data.published);
  groups.set(y, [...(groups.get(y) ?? []), post]);
}
---

<BaseLayout title="Blog" description="Notes and essays.">
  <h1 class="visually-hidden">Blog</h1>
  {
    groups.size === 0 && <p class="meta">Nothing here yet.</p>
  }
  {
    [...groups].map(([y, items]) => (
      <section class="year-group" aria-labelledby={`y-${y}`}>
        <h2 id={`y-${y}`} class="section-label">{y}</h2>
        <PostList posts={items} />
      </section>
    ))
  }
</BaseLayout>
