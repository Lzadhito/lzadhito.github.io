---
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  limit?: number;
  heading?: boolean;
  grouped?: boolean;
}

const { limit, heading = false, grouped = false } = Astro.props;
const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, limit);

const shortDate = (d: Date) => d.toLocaleDateString("en-us", { month: "short", day: "numeric" });
const groups = [
  ...Map.groupBy(posts, (post) => post.data.pubDate.getFullYear()),
].sort((a, b) => b[0] - a[0]);
---

<section>
  {
    heading && (
      <div class="flex items-baseline justify-between pb-4">
        <h2 class="m-0! text-base! font-semibold">Blog</h2>
        <a href="/blog" class="font-mono text-sm underline underline-offset-4">
          All Posts
        </a>
      </div>
    )
  }
  {
    grouped ? (
      groups.map(([year, items]) => (
        <div class="mb-8">
          <h2 class="m-0! pb-2 text-base! font-mono font-semibold text-gray-500">{year}</h2>
          <ul class="list-none p-0 m-0">
            {items.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`} class="group flex items-baseline gap-4 py-2 no-underline font-mono">
                  <time class="shrink-0 w-14 text-sm text-gray-500" datetime={post.data.pubDate.toISOString()}>
                    {shortDate(post.data.pubDate)}
                  </time>
                  <span class="flex-1 min-w-0 leading-snug group-hover:underline underline-offset-4">
                    {post.data.title}
                    {post.data.protected && (
                      <svg
                        class="inline-block mb-0.5 text-gray-500"
                        width="13"
                        height="13"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-label="Password protected"
                      >
                        <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                      </svg>
                    )}
                  </span>
                  <span class="text-gray-500 transition-transform group-hover:translate-x-1" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    ) : (
    <ul class="list-none p-0 m-0 border-t border-dotted border-gray-400">
      {
        posts.map((post) => (
          <li class="border-b border-dotted border-gray-400">
            <a href={`/blog/${post.id}/`} class="group flex gap-4 py-5 no-underline font-mono">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 mt-0.5 text-gray-500"
                aria-hidden="true"
              >
                <path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.7.7l3.9 3.9a2.4 2.4 0 0 1 .7 1.7V20a2 2 0 0 1-2 2z" />
                <path d="M14 2v5a1 1 0 0 0 1 1h5" />
                <path d="M10 9H8" />
                <path d="M16 13H8" />
                <path d="M16 17H8" />
              </svg>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between text-sm text-gray-500">
                  <FormattedDate date={post.data.pubDate} />
                  <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
                    →
                  </span>
                </div>
                <div class="leading-snug group-hover:underline underline-offset-4">
                  {post.data.title}
                  {post.data.protected && (
                    <svg
                      class="inline-block mb-0.5 text-gray-500"
                      width="13"
                      height="13"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-label="Password protected"
                    >
                      <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                      <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                  )}
                </div>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    )
  }
</section>
