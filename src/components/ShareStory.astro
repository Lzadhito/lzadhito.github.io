---
interface Props {
  title: string;
  description?: string;
  body?: string;
  date: string;
  url: string;
  siteName: string;
  domain: string;
}

const { title, description, body, date, url, siteName, domain } = Astro.props;
---

<button
  type="button"
  class="share-story-trigger inline-flex items-center justify-center w-9 h-9 rounded-full text-gray-500 hover:text-gray-800 hover:bg-black/5 transition-colors shrink-0"
  data-title={title}
  data-description={description ?? ""}
  data-body={body ?? ""}
  data-date={date}
  data-url={url}
  data-site-name={siteName}
  data-domain={domain}
  aria-haspopup="dialog"
>
  <span class="sr-only">Share this post</span>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="19"
    height="19"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path>
    <path d="m21.854 2.147-10.94 10.939"></path>
  </svg>
</button>

<dialog class="share-story-dialog">
  <div class="share-story-head">
    <h2>Share</h2>
    <button type="button" class="share-story-close" aria-label="Close">✕</button>
  </div>

  <div class="share-story-scroll">
    <div class="share-story-preview">
      <canvas class="share-story-canvas" width="1080" height="1920"></canvas>
      <p class="share-story-loading">Preparing your story card…</p>
    </div>

    <div class="share-story-actions">
      <button
        type="button"
        class="share-story-share"
        data-label-share="Share"
        data-label-fallback="Save image"
      >
        Share
      </button>
    </div>

    <p class="share-story-hint">
      Your post link is copied automatically. A story editor can't follow a link baked into a photo, so once you're in
      there, add it as a <strong>Link sticker</strong>.
    </p>
    <p class="share-story-status" role="status" aria-live="polite"></p>
    <button type="button" class="share-story-copy">Copy link again</button>
  </div>
</dialog>

<script>
  import { detectIOS, tryInstagramStoryDeepLink } from "../scripts/instagramShare";
  import { canvasToBlob, renderStoryCard, slugifyFilename } from "../scripts/storyCard";

  const triggers = document.querySelectorAll<HTMLButtonElement>(".share-story-trigger");

  for (const trigger of triggers) {
    const dialog = trigger.nextElementSibling as HTMLDialogElement | null;
    if (!dialog || dialog.tagName !== "DIALOG") continue;

    const canvas = dialog.querySelector<HTMLCanvasElement>(".share-story-canvas")!;
    const loading = dialog.querySelector<HTMLParagraphElement>(".share-story-loading")!;
    const shareBtn = dialog.querySelector<HTMLButtonElement>(".share-story-share")!;
    const copyBtn = dialog.querySelector<HTMLButtonElement>(".share-story-copy")!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>(".share-story-close")!;
    const status = dialog.querySelector<HTMLParagraphElement>(".share-story-status")!;

    const data = {
      title: trigger.dataset.title ?? "",
      description: trigger.dataset.description || undefined,
      body: trigger.dataset.body || undefined,
      date: trigger.dataset.date ?? "",
      siteName: trigger.dataset.siteName ?? "",
      domain: trigger.dataset.domain ?? "",
    };
    const url = trigger.dataset.url ?? "";
    const filename = `${slugifyFilename(data.title)}-story.png`;

    let blobPromise: Promise<Blob> | null = null;
    let opened = false;

    function setStatus(text: string) {
      status.textContent = text;
    }

    async function open() {
      dialog!.showModal();
      if (opened) return;
      opened = true;
      try {
        await renderStoryCard(canvas, data);
        loading.style.display = "none";
        canvas.classList.add("is-ready");
        blobPromise = canvasToBlob(canvas);
      } catch {
        loading.textContent = "Couldn't render a preview, but sharing still works.";
      }
      // One tap on the trigger is the whole interaction — kick the share flow off
      // right away instead of waiting for a second tap on the "Share" button below.
      void runShare();
    }

    trigger.addEventListener("click", open);
    closeBtn.addEventListener("click", () => dialog!.close());
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog!.close();
    });

    async function getBlob(): Promise<Blob> {
      if (!blobPromise) {
        await renderStoryCard(canvas, data);
        blobPromise = canvasToBlob(canvas);
      }
      return blobPromise;
    }

    const nav = navigator as Navigator & {
      canShare?: (data?: ShareData) => boolean;
      share?: (data?: ShareData) => Promise<void>;
    };
    const canShareFiles = typeof nav.canShare === "function" && typeof File !== "undefined";
    const onIOS = detectIOS();
    shareBtn.textContent = canShareFiles
      ? (shareBtn.dataset.labelShare ?? "Share")
      : (shareBtn.dataset.labelFallback ?? "Save image");

    async function copyLink(): Promise<boolean> {
      try {
        await navigator.clipboard.writeText(url);
        return true;
      } catch {
        return false;
      }
    }

    // One tap does everything: on iOS, try to jump straight into Instagram's Story
    // composer (image + link both land on the clipboard as part of that attempt).
    // Everywhere else — and if that deep link doesn't land — fall back to the system
    // share sheet (Android reliably surfaces Instagram there) or a plain download,
    // always with the link copied first. Runs automatically as soon as the preview
    // is ready (see `open()`); the "Share" button just re-runs it, e.g. to retry.
    let sharing = false;
    async function runShare() {
      if (sharing) return;
      sharing = true;
      shareBtn.disabled = true;
      setStatus("Preparing image…");
      try {
        const blob = await getBlob();

        if (onIOS) {
          setStatus("Opening Instagram…");
          const openedDeepLink = await tryInstagramStoryDeepLink(blob, url);
          if (openedDeepLink) {
            setStatus("Opening Instagram Story… the link is already on your clipboard to paste as a sticker.");
            return;
          }
        }

        const copied = await copyLink();
        const file = new File([blob], filename, { type: "image/png" });
        if (canShareFiles && nav.canShare!({ files: [file] })) {
          try {
            await nav.share!({ files: [file], title: data.title, text: copied ? undefined : url });
            setStatus(
              copied
                ? "Shared! Paste the copied link as a Link sticker in your story."
                : `Shared! Add this link as a sticker: ${url}`,
            );
            return;
          } catch (err) {
            if (err instanceof DOMException && err.name === "AbortError") {
              setStatus(copied ? "Link copied." : "");
              return;
            }
            // fall through to the download fallback below
          }
        }
        downloadBlob(blob, filename);
        setStatus(
          copied
            ? "Image saved & link copied. Open your story editor, pick this photo, then paste the link as a sticker."
            : `Image saved. Open your story editor, pick this photo, then add this link as a sticker: ${url}`,
        );
      } catch {
        setStatus("Something went wrong preparing the share.");
      } finally {
        shareBtn.disabled = false;
        sharing = false;
      }
    }

    shareBtn.addEventListener("click", () => {
      void runShare();
    });

    copyBtn.addEventListener("click", async () => {
      setStatus((await copyLink()) ? "Link copied." : `Copy this link manually: ${url}`);
    });
  }

  function downloadBlob(blob: Blob, filename: string) {
    const link = document.createElement("a");
    const objectUrl = URL.createObjectURL(blob);
    link.href = objectUrl;
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(objectUrl), 10_000);
  }
</script>

<style>
  .share-story-dialog {
    box-sizing: border-box;
    width: min(380px, calc(100vw - 2rem));
    max-height: min(640px, calc(100dvh - 2rem));
    margin: auto;
    padding: 1.1rem 1.1rem 1.25rem;
    border: 0;
    border-radius: 1.1rem;
    box-shadow: var(--box-shadow);
    color: rgb(var(--gray-dark));
    background: #fff;
    flex-direction: column;
    overflow: hidden;
  }
  /* `display: flex` must only apply once the dialog is actually open (via
     showModal()) — an unconditional `display` here is an author-stylesheet
     rule, which always wins over the UA's `dialog:not([open]) { display: none }`
     default regardless of specificity, so the sheet would otherwise render
     inline in the page flow (and, under the mobile media query below, get
     pinned open at the bottom of the screen) as soon as the page loads. */
  .share-story-dialog[open] {
    display: flex;
  }
  .share-story-dialog::backdrop {
    background: rgba(15, 18, 25, 0.55);
  }
  .share-story-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 0 0 auto;
    margin-bottom: 0.6rem;
  }
  .share-story-head h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }
  .share-story-close {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 0;
    border-radius: 999px;
    background: none;
    font-size: 0.9rem;
    line-height: 1;
    cursor: pointer;
    color: rgb(var(--gray));
  }
  .share-story-close:hover {
    background: rgb(var(--gray-light));
    color: rgb(var(--gray-dark));
  }
  .share-story-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }
  .share-story-preview {
    position: relative;
    aspect-ratio: 1080 / 1920;
    width: 100%;
    max-height: 38dvh;
    margin: 0 auto;
    border-radius: 0.75rem;
    overflow: hidden;
    /* Same surface tone as the card itself so the preview reads as one continuous
       object instead of a canvas boxed inside an unrelated gray frame. */
    background: #e1e6d9;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .share-story-canvas {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .share-story-canvas.is-ready {
    opacity: 1;
  }
  .share-story-loading {
    position: absolute;
    margin: 0;
    font-size: 0.85rem;
    color: rgb(var(--gray));
  }
  .share-story-actions {
    flex: 0 0 auto;
    margin-top: 0.9rem;
  }
  .share-story-share {
    width: 100%;
    padding: 0.7rem 1rem;
    border-radius: 0.6rem;
    border: 1px solid #2f6b00;
    background: #2f6b00;
    color: #f8fdef;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
  }
  .share-story-share:active {
    background: #1f4d00;
    border-color: #1f4d00;
  }
  .share-story-share:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .share-story-hint {
    flex: 0 0 auto;
    margin: 0.7rem 0 0;
    font-size: 0.75rem;
    line-height: 1.4;
    color: rgb(var(--gray));
  }
  .share-story-status {
    flex: 0 0 auto;
    margin: 0.4rem 0 0;
    min-height: 1em;
    font-size: 0.78rem;
    color: #2f6b00;
  }
  .share-story-copy {
    flex: 0 0 auto;
    display: block;
    margin: 0.35rem auto 0;
    padding: 0.25rem;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.75rem;
    text-decoration: underline;
    text-underline-offset: 2px;
    color: rgb(var(--gray));
    cursor: pointer;
  }

  @media (max-width: 480px) {
    .share-story-dialog {
      position: fixed;
      inset: auto 0 0 0;
      width: 100%;
      max-width: 100%;
      max-height: min(85dvh, 640px);
      margin: 0;
      border-radius: 1.25rem 1.25rem 0 0;
      padding-bottom: calc(1.1rem + env(safe-area-inset-bottom));
    }
  }
</style>
