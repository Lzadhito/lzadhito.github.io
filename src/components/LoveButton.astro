---
// Medium-style clap button: tap repeatedly (up to the per-visitor cap) to clap for a post.
// Sized and styled to sit next to ShareStory's icon button in the post meta row.
// Renders nothing until src/love/config.ts is filled in — see docs/love-button-and-analytics-setup.md.
import { LOVE_API } from "../love/config";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

{
  LOVE_API.proxy && (
    <span class="love-button" data-slug={slug}>
      <button
        type="button"
        class="love-tap inline-flex items-center justify-center w-9 h-9 rounded-full text-gray-500 hover:text-gray-800 hover:bg-black/5 transition-colors shrink-0"
        aria-label="Clap for this post"
      >
        <span class="love-burst" aria-hidden="true" />
        <svg class="love-heart" width="19" height="19" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 L12,21.35 Z" />
        </svg>
        <span class="love-count" aria-hidden="true">0</span>
      </button>
    </span>
  )
}

<script>
  import { mountAll } from "../love/client";
  import { LOVE_API } from "../love/config";
  mountAll(LOVE_API);
</script>

<style>
  .love-tap {
    position: relative;
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .love-tap.is-maxed {
    cursor: default;
  }
  .love-heart {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
    transition:
      fill 150ms ease,
      stroke 150ms ease;
  }
  .love-tap.is-active .love-heart {
    fill: var(--accent-dark);
    stroke: var(--accent-dark);
  }
  .love-tap.is-clapping .love-heart {
    animation: love-pop 320ms ease;
  }
  .love-burst {
    position: absolute;
    inset: 4px;
    border-radius: 999px;
    border: 1.5px solid var(--accent);
    opacity: 0;
    pointer-events: none;
  }
  .love-tap.is-clapping .love-burst {
    animation: love-burst 420ms ease-out;
  }
  .love-count {
    position: absolute;
    top: -0.15rem;
    right: -0.2rem;
    font-size: 0.625rem;
    line-height: 1;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: rgb(var(--gray));
    pointer-events: none;
    transition: color 150ms ease;
  }
  .love-tap.is-active .love-count {
    color: var(--accent-dark);
  }

  @keyframes love-pop {
    0% {
      transform: scale(1);
    }
    35% {
      transform: scale(1.3);
    }
    65% {
      transform: scale(0.94);
    }
    100% {
      transform: scale(1);
    }
  }
  @keyframes love-burst {
    0% {
      transform: scale(0.7);
      opacity: 0.6;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .love-tap.is-clapping .love-heart,
    .love-tap.is-clapping .love-burst {
      animation: none;
    }
  }
</style>
