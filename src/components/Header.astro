---
import { AUTHOR } from '../consts';

const path = Astro.url.pathname;
const links = [
  { href: '/blog/', label: 'Blog', current: path.startsWith('/blog') },
  { href: '/about/', label: 'About', current: path.startsWith('/about') },
];
---

<header class="site-header">
  <a class="site-name" href="/">{AUTHOR}</a>
  <nav class="nav" aria-label="Main">
    {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
  </nav>
</header>
