---
// Shown in place of a protected post's body (see BlogPost.astro). `blob` is the ciphertext
// straight from the .md file — never the plaintext — and unlocking happens entirely in the
// browser. See src/lib/postCrypto.ts (encryption) and src/scripts/passwordGate.ts (this UI).
interface Props {
  slug: string;
  blob?: string;
}
const { slug, blob } = Astro.props;
---

<div class="password-gate" data-slug={slug} data-blob={blob}>
  <svg
    class="password-gate-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
  </svg>
  <p class="password-gate-msg">This post is password protected.</p>
  <form class="password-gate-form">
    <input type="password" class="password-gate-input" placeholder="Password" autocomplete="off" autofocus />
    <button type="submit" class="password-gate-submit">Unlock</button>
  </form>
  <p class="password-gate-error" hidden>Wrong password. Try again.</p>
</div>

<script>
  import { mountAll } from "../scripts/passwordGate";
  mountAll();
</script>

<style>
  .password-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 2.25rem 1.5rem;
    text-align: center;
    background: rgba(var(--gray-light), 0.45);
    border-radius: 0.75rem;
  }
  .password-gate-icon {
    color: rgb(var(--gray));
  }
  .password-gate-msg {
    margin: 0;
    font-size: 0.9375rem;
    color: rgb(var(--gray));
  }
  .password-gate-form {
    display: flex;
    width: 100%;
    max-width: 20rem;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .password-gate-input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    background: #fff;
    border: 1px solid rgba(var(--gray), 0.3);
    border-radius: 0.5rem;
    font: inherit;
    font-size: 0.9375rem;
  }
  .password-gate-input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .password-gate-submit {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.5rem;
    background: var(--accent-dark);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 150ms ease;
  }
  .password-gate-submit:hover {
    background: rgb(var(--black));
  }
  .password-gate-submit:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .password-gate-error {
    margin: 0;
    font-size: 0.8125rem;
    color: #c0392b;
  }
</style>
