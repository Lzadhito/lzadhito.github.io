---
// Shown in place of a protected post's body (see BlogPost.astro). `blob` is the ciphertext
// straight from the .md file — never the plaintext — and unlocking happens entirely in the
// browser. See src/lib/postCrypto.ts (encryption) and src/scripts/passwordGate.ts (this UI).
interface Props {
  slug: string;
  blob?: string;
}
const { slug, blob } = Astro.props;
---

<div class="password-gate" data-slug={slug} data-blob={blob}>
  <p class="password-gate-lock" aria-hidden="true">🔒</p>
  <p class="password-gate-msg">This post is password protected.</p>
  <form class="password-gate-form">
    <input type="password" class="password-gate-input" placeholder="Password" autocomplete="off" autofocus />
    <button type="submit" class="password-gate-submit">Unlock</button>
  </form>
  <p class="password-gate-error" hidden>Wrong password. Try again.</p>
</div>

<script>
  import { mountAll } from "../scripts/passwordGate";
  mountAll();
</script>

<style>
  .password-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 3rem 1.5rem;
    text-align: center;
    border: 1px dashed rgb(var(--gray-light));
    border-radius: 0.75rem;
  }
  .password-gate-lock {
    margin: 0;
    font-size: 1.75rem;
    line-height: 1;
  }
  .password-gate-msg {
    margin: 0;
    color: rgb(var(--gray));
  }
  .password-gate-form {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .password-gate-input {
    padding: 0.5rem 0.75rem;
    border: 1px solid rgb(var(--gray-light));
    border-radius: 0.5rem;
    font: inherit;
    font-size: 1rem;
  }
  .password-gate-input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .password-gate-submit {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 0.5rem;
    background: var(--accent-dark);
    color: #fff;
    font-weight: 600;
    cursor: pointer;
  }
  .password-gate-submit:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .password-gate-error {
    margin: 0;
    font-size: 0.875rem;
    color: #c0392b;
  }
</style>
